@startuml
title State Diagram: Booking Lifecycle
scale 600 width

[*] --> PendingApproval : Passenger Requests Booking

state "Pending Approval" as PendingApproval {
  [*] --> WaitingForDriver
  WaitingForDriver --> DriverReviews : Driver notified
}

PendingApproval --> Confirmed : Driver Accepts
PendingApproval --> Cancelled : Driver Rejects
PendingApproval --> Cancelled : Passenger Cancels

state Confirmed {
  [*] --> PaymentPending : If Online Payment
  PaymentPending --> PaymentSuccess : User Pays
  PaymentSuccess --> ReadyForRide
  
  [*] --> ReadyForRide : If Cash Payment
}

Confirmed --> Cancelled : Passenger/Driver Cancels
note on link
  <b>Penalties:</b>
  * <b>Driver:</b> ₹100 fine (if < 20 mins before start)
  * <b>Passenger:</b> Extra charge on next ride
  * <b>Consequence:</b> Temporary account block for both
end note
Confirmed --> CompletionPending : Ride Finished\n(Wait for OTP/Confirm)

state "Completion Pending" as CompletionPending
CompletionPending --> Completed : OTP Verified / User Confirms

Completed --> [*]
Cancelled --> [*]

note right of Completed
  Refunds may be processed
  if Cancellation happened
  after payment.
end note

@enduml
