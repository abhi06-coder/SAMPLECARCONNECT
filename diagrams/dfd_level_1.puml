@startuml
title DFD Level 1
top to bottom direction

skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 16
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80

' White Background, Black Text
skinparam BackgroundColor white
skinparam ArrowColor black
skinparam MessageAlign center

skinparam rectangle {
    BackgroundColor white
    BorderColor black
    FontColor black
}

skinparam usecase {
    BackgroundColor white
    BorderColor black
    FontColor black
    ' Making them larger
    MinimumWidth 150
}

skinparam database {
    BackgroundColor white
    BorderColor black
    FontColor black
}

' Entities (Rectangles)
rectangle "Passenger" as Pass
rectangle "Driver" as Driv
rectangle "Admin" as Adm
rectangle "Razorpay\nGateway" as RP
rectangle "Firebase\nAuth" as FA

' Processes (Circles/Ovals formatted to seem circular)
' Using newlines and padding to make them roughly circular
usecase "1.0\nAuthentication" as P1
usecase "2.0\nRide\nManagement" as P2
usecase "3.0\nBooking\nSystem" as P3
usecase "4.0\nPayment\nProcessing" as P4
usecase "5.0\nAdmin\nOperations" as P5

' Data Stores (Cylinders)
database "User\nDatabase" as DS1
database "Ride\nDatabase" as DS2
database "Booking\nDatabase" as DS3

' Flows

' 1. Auth Flow
Pass --> P1 : Login
Driv --> P1 : Login
P1 --> FA : Verify
FA --> P1 : Valid
P1 --> DS1 : CRUD
DS1 .u.> P1 : User Data

' 2. Ride Mgmt
Driv --> P2 : Offer Ride
P2 --> DS2 : Save
DS2 .u.> P2 : Confirm

' 3. Booking
Pass --> P3 : Search
P3 --> DS2 : Query
DS2 .u.> P3 : Results
Pass --> P3 : Request
P3 --> Driv : Notify
Driv --> P3 : Action
P3 --> DS3 : Create
DS3 .u.> P3 : Booking ID

' 4. Payment
Pass --> P4 : Pay
P4 --> RP : Order
RP --> P4 : Status
P4 --> DS3 : Update

' 5. Admin
Adm --> P5 : Actions
P5 --> DS1 : Block
P5 --> DS3 : Refund

@enduml
