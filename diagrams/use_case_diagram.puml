@startuml
left to right direction
skinparam packageStyle rectangle

actor "Passenger" as P
actor "Driver" as D

package "Car Connect System" {

  ' Authentication
  usecase "Sign Up / Login" as UC1
  usecase "Verify Phone Number" as UC2
  usecase "Manage Profile" as UC3
  
  ' Ride Management (Driver)
  usecase "Offer Ride" as UC4
  usecase "Manage Commute Template" as UC5
  usecase "Update/Cancel Ride" as UC6
  usecase "Process Booking Request" as UC7
  
  ' Ride Booking (Passenger)
  usecase "Search Rides" as UC8
  usecase "Book Ride" as UC9
  usecase "Rate Driver/Passenger" as UC11
  
  ' Payments & Wallet
  usecase "Make Payment" as UC12
  usecase "Add Money to Wallet" as UC13
  usecase "Request Refund" as UC14
  
  ' Admin Actions
  usecase "Manage Users (Block/Unblock)" as UC15
  usecase "Approve Refunds" as UC16
  usecase "View Logs/Analytics" as UC17

}

' Relationships & Inheritance
P <|-- D : "Extends User Features"
note right of D : Drivers can also act as Passengers

' Auth
P --> UC1
P --> UC3
UC1 ..> UC2 : <<include>>

' Driver Flows
D --> UC4
D --> UC5
D --> UC6
D --> UC7
D --> UC13

' Passenger Flows
P --> UC8
P --> UC9
P --> UC11
P --> UC14

' Booking Logic
UC9 ..> UC12 : <<include>> \n(Payment Required)

' Admin Flows (Placed on Right Side)
actor "Admin" as A
UC15 <-- A
UC16 <-- A
UC17 <-- A

@enduml
