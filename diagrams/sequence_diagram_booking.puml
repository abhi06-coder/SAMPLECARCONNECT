@startuml
title Sequence Diagram: Successful Ride Booking
autonumber

actor "Passenger" as P
participant "WebApp (Frontend)" as FE
participant "CarConnect API (Backend)" as BE
database "Database" as DB
actor "Driver" as D

P -> FE: Clicks "Request to Book"
activate FE

FE -> BE: POST /api/bookings/book\n(rideId, seats)
activate BE

BE -> DB: Save Booking\n(Status: pending_approval)
activate DB
DB --> BE: Booking Created
deactivate DB

BE -> D: Notify New Booking Request
deactivate BE
activate D

D -> FE: View Booking Request
FE -> D: Display Request Details

D -> FE: Clicks "Accept"
FE -> BE: PUT /api/bookings/:id/status\n(status: confirmed)
activate BE

BE -> DB: Update Booking Status\n(confirmed)
activate DB
DB --> BE: Success
deactivate DB

BE -> P: Notify Booking Confirmed
BE --> FE: 200 OK
deactivate BE

FE -> D: Show "Booking Confirmed"
deactivate FE

P -> FE: Receives Notification
activate P
FE -> P: Display "Booking Confirmed"
deactivate P

@enduml
