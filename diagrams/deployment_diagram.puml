@startuml
title Deployment Diagram: CarConnect System

node "Client Device (Mobile/PC)" as Client {
    component "Web Browser" {
        artifact "React Frontend App"
    }
}

node "Backend Server" as Server {
    component "Node.js Runtime" {
        artifact "Express API"
    }
}

database "MongoDB Atlas" as DB {
    component "Database Cluster"
}

cloud "External Services" {
    node "Firebase" as FB {
        component "Auth Service"
    }
    node "Razorpay" as RP {
        component "Payment Gateway"
    }
}

' Connections
Client -- Server : HTTPS (JSON/REST)
Client ..> FB : Authentication (SDK)
Client ..> RP : Checkout UI

Server -- DB : MongoDB Protocol (Part of Connection String)
Server ..> FB : Admin SDK (Verify Tokens)
Server ..> RP : API (Create Orders)

@enduml
